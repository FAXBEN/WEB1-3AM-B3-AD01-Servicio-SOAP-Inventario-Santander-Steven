{
  "info": {
    "_postman_id": "f7b4d4c2-21ec-4d71-8687-15ffbd6506cf",
    "name": "InventarioREST",
    "description": "Métodos REST para administrar Movimiento_Inventario.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5163"
    },
    {
      "key": "movimientoId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "ObtenerMovimientos",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/MovimientoInventario"
      }
    },
    {
      "name": "ObtenerMovimiento",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/MovimientoInventario/{{movimientoId}}"
      }
    },
    {
      "name": "GuardarMovimiento",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 201) {",
              "  const movimiento = pm.response.json();",
              "  pm.collectionVariables.set('movimientoId', movimiento.idMovimiento);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"idProducto\": 1,\n  \"tipoMovimiento\": \"ENTRADA\",\n  \"cantidad\": 6,\n  \"fechaMovimiento\": \"2026-09-01T21:00:00\",\n  \"observacion\": \"Movimiento creado desde Postman\"\n}"
        },
        "url": "{{baseUrl}}/api/MovimientoInventario"
      }
    },
    {
      "name": "ActualizarMovimiento",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"idProducto\": 3,\n  \"tipoMovimiento\": \"SALIDA\",\n  \"cantidad\": 2,\n  \"fechaMovimiento\": \"2026-09-01T21:15:00\",\n  \"observacion\": \"Movimiento actualizado desde Postman\"\n}"
        },
        "url": "{{baseUrl}}/api/MovimientoInventario/{{movimientoId}}"
      }
    },
    {
      "name": "EliminarMovimiento",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/api/MovimientoInventario/{{movimientoId}}"
      }
    }
  ]
}
