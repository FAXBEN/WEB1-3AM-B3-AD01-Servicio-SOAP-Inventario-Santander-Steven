      "name": "AgregarCategoria",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "text/xml; charset=utf-8"
          },
          {
            "key": "SOAPAction",
            "value": "\"http://tempuri.org/ICatalogoService/AgregarCategoria\""
          }
        ],
        "url": "{{baseUrl}}/CatalogoService.svc",
        "body": {
          "mode": "raw",
          "raw": "<s:Envelope xmlns:s=\"http://schemas.xmlsoap.org/soap/envelope/\" xmlns:t=\"http://tempuri.org/\" xmlns:i=\"http://schemas.datacontract.org/2004/07/InventarioSOAP_A.Models\">\n  <s:Body><t:AgregarCategoria><t:categoria><i:Descripcion>Demostracion AA</i:Descripcion><i:Estado>true</i:Estado><i:IdCategoria>0</i:IdCategoria><i:Nombre>Categoria prueba AA</i:Nombre></t:categoria></t:AgregarCategoria></s:Body>\n</s:Envelope>",
          "options": {
            "raw": {
              "language": "xml"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "[\"categoriaId\", \"productoId\", \"movimientoId\"].forEach(k => pm.collectionVariables.set(k, \"0\"));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) { const m = pm.response.text().match(/<(?:[A-Za-z_][A-Za-z0-9_]*:)?IdCategoria>([0-9]+)<\\//); if (m) pm.collectionVariables.set(\"categoriaId\", m[1]); }",
              "pm.test(\"ID nuevo válido\", () => pm.expect(Number(pm.collectionVariables.get(\"categoriaId\"))).to.be.above(0));"
            ]
          }
        }
      ]
    },
